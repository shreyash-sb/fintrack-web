# Server Configuration
PORT=3000
NODE_ENV=production

# MySQL Database Configuration (Local or Cloud)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="your_database_password"
DB_NAME=fintrack_db
DB_SSL=false

# Alternative: Cloud Database URL (TiDB Cloud, Railway, Aiven, etc.)
# DATABASE_URL=mysql://username:password@gateway.provider.com:3306/fintrack_db

# Security & Authentication
JWT_SECRET=generate_a_random_32_character_string_here
JWT_EXPIRES_IN=7d

# Cloudinary Storage Configuration (Optional - for receipt photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
